#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура цм_ПодборЦветов(Команда)

	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидЦены", Объект.ВидЦены);
	ПараметрыФормы.Вставить("Валюта", Объект.Валюта);

	ОткрытьФорму("Обработка.цм_ПодборЦветов.Форма.Форма", ПараметрыФормы, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("цм_ПодборЦветовЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура цм_ПлюсОдин(Команда)

	цм_ИзменитьКоличествоТекущейСтроки(1);

КонецПроцедуры

&НаКлиенте
Процедура цм_МинусОдин(Команда)

	цм_ИзменитьКоличествоТекущейСтроки(-1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Переносит набранное в форме подбора цветов в чек типовым путём быстрых товаров РМК
// (ДобавитьВКорзинуФрагмент): цена по виду цен чека, НДС, продавец, скидки - типовым кодом;
// строка с тем же товаром, упаковкой и ценой не дублируется, а получает добавленное количество.
//
// Параметры:
//  Результат - Массив из Структура, Неопределено - результат закрытия формы подбора:
//   * Номенклатура - СправочникСсылка.Номенклатура - цветок.
//   * ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - тип номенклатуры.
//   * КоличествоУпаковок - Число - количество.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура цм_ПодборЦветовЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Или Результат.Количество() = 0 Или ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	НовыеСтроки = Новый Массив;
	Для Каждого Выбранное Из Результат Цикл

		ПараметрыТовара = цм_ПараметрыТовараПодбора(Выбранное);

		// Набор раскладывается на комплектующие типовым кодом: он и спросит количество, если так настроено.
		Если Выбранное.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Набор") Тогда
			ДобавитьВКорзину(ПараметрыТовара);
		Иначе
			НовыеСтроки.Добавить(ПараметрыТовара);
		КонецЕсли;

	КонецЦикла;

	Если НовыеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Упаковку и цену пустой строки заполняет типовой ДобавитьВКорзинуНаСервере; цена берётся
	// при типе номенклатуры общих параметров, отличном от «Набор».
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("НовыеСтроки", НовыеСтроки);
	ПараметрыДанных.Вставить("ПараметрыТовара", цм_ПараметрыТовараПодбора(Неопределено));

	ДобавитьВКорзинуФрагмент(ПараметрыДанных);

КонецПроцедуры

// Параметры товара для типового добавления в чек.
//
// Параметры:
//  Выбранное - Структура, Неопределено - строка результата подбора; Неопределено - общие параметры
//              пакета: только продавец.
//
// Возвращаемое значение:
//  Структура - см. ПодборТоваровКлиентСервер.ПараметрыТовара.
//
&НаКлиенте
Функция цм_ПараметрыТовараПодбора(Выбранное)

	ПараметрыТовара = ПодборТоваровКлиентСервер.ПараметрыТовара();
	ПараметрыТовара.Продавец = ТекущийПродавец;
	Если Выбранное <> Неопределено Тогда
		ПараметрыТовара.Номенклатура = Выбранное.Номенклатура;
		ПараметрыТовара.ТипНоменклатуры = Выбранное.ТипНоменклатуры;
		ПараметрыТовара.КоличествоУпаковок = Выбранное.КоличествоУпаковок;
	КонецЕсли;

	Возврат ПараметрыТовара;

КонецФункции

// Меняет количество текущей строки чека и пересчитывает её типовым обработчиком изменения количества.
//
// Параметры:
//  Изменение - Число - на сколько изменить количество упаковок.
//
&НаКлиенте
Процедура цм_ИзменитьКоличествоТекущейСтроки(Изменение)

	Если ТолькоПросмотр Или Элементы.Товары.ТолькоПросмотр Или Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ЗначениеЗаполнено(ТекущиеДанные.НоменклатураНабора) Тогда
		Возврат;
	КонецЕсли;

	НовоеКоличество = ТекущиеДанные.КоличествоУпаковок + Изменение;
	Если НовоеКоличество <= 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Количество не может быть меньше 1.
			|Удалить строку: клавиша Del или команда «Удалить» контекстного меню чека.'"));
		Возврат;
	КонецЕсли;

	ТекущиеДанные.КоличествоУпаковок = НовоеКоличество;
	ТоварыКоличествоУпаковокПриИзменении(Элементы.ТоварыКоличествоУпаковок);
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти