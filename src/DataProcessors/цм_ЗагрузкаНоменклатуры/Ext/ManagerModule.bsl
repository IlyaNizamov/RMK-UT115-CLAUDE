#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Загружает номенклатуру цветочного магазина из каталога данных задания: группы, вид
// номенклатуры, единицы, товары, штрихкоды, картинки и розничные цены. Повторный запуск
// находит загруженное и ничего не дублирует.
//
// Параметры:
//  КаталогДанных - Строка - каталог, в котором лежат data/nomenclature.json и images/.
//
// Возвращаемое значение:
//  Структура - итог загрузки:
//   * Создано   - Число - создано объектов всех видов.
//   * Обновлено - Число - обновлено объектов всех видов.
//   * Пропущено - Число - найдено без изменений.
//   * Подробно  - Структура - те же счетчики по видам: Группы, Товары, Штрихкоды, Цены,
//                 Картинки; значение - Структура(Создано, Обновлено, Пропущено).
//   * Ошибки    - Массив из Строка - тексты ошибок; ошибка одного товара не мешает остальным.
//
Функция Загрузить(Знач КаталогДанных) Экспорт

	Итог = НовыйИтог();

	Данные = ПрочитатьДанные(КаталогДанных, Итог);
	Если Данные = Неопределено Тогда
		Возврат ЗавершитьИтог(Итог);
	КонецЕсли;

	Контекст = НовыйКонтекст(КаталогДанных, Данные);

	Попытка
		ПодготовитьСправочныеДанные(Контекст);
	Исключение
		Итог.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Не подготовлены вид номенклатуры и единицы: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат ЗавершитьИтог(Итог);
	КонецПопытки;

	ПрочитатьЗагруженное(Контекст);

	ЗагрузитьГруппы(Контекст, Итог);

	Для Каждого Товар Из Данные["items"] Цикл
		ЗагрузитьТовар(Контекст, Товар, Итог);
	КонецЦикла;

	ЗаписатьЦены(Контекст, Итог);

	Возврат ЗавершитьИтог(Итог);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Итог

Функция НовыйИтог()

	Подробно = Новый Структура;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Подробно.Вставить(Вид, НовыеСчетчики());
	КонецЦикла;

	Итог = Новый Структура;
	Итог.Вставить("Создано", 0);
	Итог.Вставить("Обновлено", 0);
	Итог.Вставить("Пропущено", 0);
	Итог.Вставить("Подробно", Подробно);
	Итог.Вставить("Ошибки", Новый Массив);

	Возврат Итог;

КонецФункции

Функция ВидыОбъектов()

	Возврат СтрРазделить("Группы,Товары,Штрихкоды,Цены,Картинки", ",");

КонецФункции

Функция НовыеСчетчики()

	Возврат Новый Структура("Создано, Обновлено, Пропущено", 0, 0, 0);

КонецФункции

// Прибавляет единицу к счетчику вида объектов.
//
// Параметры:
//  Подробно - Структура - счетчики по видам объектов, см. НовыйИтог.
//  Вид      - Строка - Группы, Товары, Штрихкоды, Цены, Картинки.
//  Исход    - Строка - Создано, Обновлено, Пропущено.
//
Процедура Учесть(Подробно, Вид, Исход)

	Подробно[Вид][Исход] = Подробно[Вид][Исход] + 1;

КонецПроцедуры

// Переносит счетчики одного товара в общий итог - после фиксации его транзакции.
//
// Параметры:
//  Подробно  - Структура - счетчики итога по видам объектов, см. НовыйИтог.
//  Слагаемое - Структура - счетчики товара или группы по тем же видам:
//   * Ключ     - Строка - вид объектов.
//   * Значение - Структура - счетчики Создано, Обновлено, Пропущено.
//
Процедура ПрибавитьСчетчики(Подробно, Слагаемое)

	Для Каждого Вид Из Слагаемое Цикл
		Для Каждого Исход Из Вид.Значение Цикл
			Подробно[Вид.Ключ][Исход.Ключ] = Подробно[Вид.Ключ][Исход.Ключ] + Исход.Значение;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЗавершитьИтог(Итог)

	Для Каждого Вид Из Итог.Подробно Цикл
		Итог.Создано = Итог.Создано + Вид.Значение.Создано;
		Итог.Обновлено = Итог.Обновлено + Вид.Значение.Обновлено;
		Итог.Пропущено = Итог.Пропущено + Вид.Значение.Пропущено;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Процедура ДобавитьОшибку(Итог, Шаблон, Предмет, Причина)

	Итог.Ошибки.Добавить(СтрШаблон(Шаблон, Предмет, Причина));

КонецПроцедуры

#КонецОбласти

#Область ЧтениеДанных

Функция ПрочитатьДанные(КаталогДанных, Итог)

	Если ПустаяСтрока(КаталогДанных) Тогда
		Итог.Ошибки.Добавить(НСтр("ru = 'Не указан каталог данных'"));
		Возврат Неопределено;
	КонецЕсли;

	ПутьКФайлу = ПолныйПуть(КаталогДанных, "data/nomenclature.json");
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		ДобавитьОшибку(Итог, НСтр("ru = 'Нет файла %1 %2'"), ПутьКФайлу, "");
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу, "UTF-8");
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Чтение.Закрыть();
		ДобавитьОшибку(Итог, НСтр("ru = 'Файл %1 не прочитан: %2'"), ПутьКФайлу,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Соответствие")
		Или ТипЗнч(Данные["groups"]) <> Тип("Массив")
		Или ТипЗнч(Данные["items"]) <> Тип("Массив") Тогда
		ДобавитьОшибку(Итог, НСтр("ru = 'В файле %1 нет массивов groups и items %2'"), ПутьКФайлу, "");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Путь файла задания: относительный путь JSON (через "/") от каталога данных.
//
// Параметры:
//  КаталогДанных     - Строка - каталог данных задания; разделитель в конце допускается.
//  ОтносительныйПуть - Строка - путь от каталога данных через "/".
//
// Возвращаемое значение:
//  Строка - полный путь с разделителем пути сервера.
//
Функция ПолныйПуть(КаталогДанных, ОтносительныйПуть)

	Разделитель = ПолучитьРазделительПутиСервера();
	Каталог = СокрЛП(КаталогДанных);
	Если СтрЗаканчиваетсяНа(Каталог, "/") Или СтрЗаканчиваетсяНа(Каталог, "\") Тогда
		Каталог = Лев(Каталог, СтрДлина(Каталог) - 1);
	КонецЕсли;

	Возврат Каталог + Разделитель + СтрЗаменить(ОтносительныйПуть, "/", Разделитель);

КонецФункции

Функция НовыйКонтекст(КаталогДанных, Данные)

	Мета = Данные["meta"];
	ВидЦеныИмя = "";
	Если ТипЗнч(Мета) = Тип("Соответствие") И ЗначениеЗаполнено(Мета["priceType"]) Тогда
		ВидЦеныИмя = Мета["priceType"];
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("КаталогДанных", КаталогДанных);
	Контекст.Вставить("Данные", Данные);
	Контекст.Вставить("ДатаЦен", ТекущаяДатаСеанса());
	Контекст.Вставить("ВидЦеныИмя", ВидЦеныИмя);
	Контекст.Вставить("ВидЦены", Справочники.ВидыЦен.ПустаяСсылка());
	Контекст.Вставить("ВалютаЦены", Справочники.Валюты.ПустаяСсылка());
	Контекст.Вставить("ВидНоменклатуры", Справочники.ВидыНоменклатуры.ПустаяСсылка());
	Контекст.Вставить("Единицы", Новый Соответствие);
	Контекст.Вставить("КорневаяГруппа", Справочники.Номенклатура.ПустаяСсылка());
	Контекст.Вставить("Группы", Новый Соответствие);
	Контекст.Вставить("ГруппыПоКоду", Новый Соответствие);
	Контекст.Вставить("ТоварыПоКоду", Новый Соответствие);
	Контекст.Вставить("ТоварыПоАртикулу", Новый Соответствие);
	Контекст.Вставить("Штрихкоды", Новый Соответствие);
	Контекст.Вставить("Файлы", Новый Соответствие);

	НовыеЦены = Новый ТаблицаЗначений;
	НовыеЦены.Колонки.Добавить("Номенклатура");
	НовыеЦены.Колонки.Добавить("Код");
	НовыеЦены.Колонки.Добавить("Цена");
	НовыеЦены.Колонки.Добавить("Исход");
	Контекст.Вставить("НовыеЦены", НовыеЦены);

	Возврат Контекст;

КонецФункции

// Одним запросом на вид данных читает то, что уже загружено: группы и товары по кодам и
// артикулам, штрихкоды из JSON и присоединенные файлы с именами картинок.
//
// Параметры:
//  Контекст - Структура - контекст загрузки, см. НовыйКонтекст; заполняются ГруппыПоКоду,
//             ТоварыПоКоду, ТоварыПоАртикулу, Штрихкоды и Файлы.
//
Процедура ПрочитатьЗагруженное(Контекст)

	Коды = Новый Массив;
	Артикулы = Новый Массив;
	Штрихкоды = Новый Массив;
	ИменаФайлов = Новый Массив;

	Коды.Добавить(КодКорневойГруппы());
	Для Каждого Группа Из Контекст.Данные["groups"] Цикл
		Коды.Добавить(КодГруппы(Группа["order"]));
		ИменаФайлов.Добавить(Группа["code"]);
	КонецЦикла;
	Для Каждого Товар Из Контекст.Данные["items"] Цикл
		Коды.Добавить(Товар["code"]);
		Артикулы.Добавить(Товар["article"]);
		Штрихкоды.Добавить(Товар["barcode"]);
		ИменаФайлов.Добавить(ИмяКартинкиТовара(Товар));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	СокрЛП(Номенклатура.Код) КАК Код,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И (СокрЛП(Номенклатура.Код) В (&Коды)
	|			ИЛИ Номенклатура.Артикул В (&Артикулы)
	|				И НЕ Номенклатура.ЭтоГруппа)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка,
	|	Файлы.ВладелецФайла КАК ВладелецФайла,
	|	Файлы.Наименование КАК Наименование,
	|	Файлы.Описание КАК Описание
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
	|ГДЕ
	|	НЕ Файлы.ПометкаУдаления
	|	И Файлы.Наименование В (&ИменаФайлов)";
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("Артикулы", Артикулы);
	Запрос.УстановитьПараметр("Штрихкоды", Штрихкоды);
	Запрос.УстановитьПараметр("ИменаФайлов", ИменаФайлов);
	Результаты = Запрос.ВыполнитьПакет();

	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Тогда
			Контекст.ГруппыПоКоду.Вставить(Выборка.Код, Выборка.Ссылка);
		Иначе
			Контекст.ТоварыПоКоду.Вставить(Выборка.Код, Выборка.Ссылка);
			Если ЗначениеЗаполнено(Выборка.Артикул) Тогда
				Контекст.ТоварыПоАртикулу.Вставить(Выборка.Артикул, Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Контекст.Штрихкоды.Вставить(Выборка.Штрихкод, Выборка.Номенклатура);
	КонецЦикла;

	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапомнитьФайл(Контекст, Выборка.ВладелецФайла, Выборка.Наименование, Выборка.Ссылка, Выборка.Описание);
	КонецЦикла;

КонецПроцедуры

Процедура ЗапомнитьФайл(Контекст, Владелец, Имя, Ссылка, Описание)

	ФайлыВладельца = Контекст.Файлы[Владелец];
	Если ФайлыВладельца = Неопределено Тогда
		ФайлыВладельца = Новый Соответствие;
		Контекст.Файлы.Вставить(Владелец, ФайлыВладельца);
	КонецЕсли;
	ФайлыВладельца.Вставить(Имя, Новый Структура("Ссылка, Описание", Ссылка, Описание));

КонецПроцедуры

Функция НайденныйФайл(Контекст, Владелец, Имя)

	ФайлыВладельца = Контекст.Файлы[Владелец];
	Если ФайлыВладельца = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ФайлыВладельца[Имя];

КонецФункции

Функция КодКорневойГруппы()

	Возврат "ЦВГ-00";

КонецФункции

Функция НаименованиеКорневойГруппы()

	Возврат НСтр("ru = 'Цветочный магазин'");

КонецФункции

Функция КодГруппы(Порядок)

	Возврат "ЦВГ-" + Формат(Порядок, "ЧЦ=2; ЧВН=; ЧГ=0");

КонецФункции

Функция ИмяКартинкиТовара(Товар)

	Возврат Товар["article"];

КонецФункции

#КонецОбласти

#Область СправочныеДанные

// Находит или создает вид номенклатуры, единицы измерения из JSON и вид цен.
//
// Параметры:
//  Контекст - Структура - контекст загрузки, см. НовыйКонтекст; заполняются Единицы,
//             ВидНоменклатуры, ВидЦены и ВалютаЦены.
//
Процедура ПодготовитьСправочныеДанные(Контекст)

	ПодготовитьЕдиницы(Контекст);
	Контекст.ВидНоменклатуры = ВидНоменклатурыЦветы(Контекст.Единицы["шт"]);

	Если ЗначениеЗаполнено(Контекст.ВидЦеныИмя) Тогда
		Контекст.ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию(Контекст.ВидЦеныИмя, Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контекст.ВидЦены) Тогда
		Контекст.ВалютаЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.ВидЦены, "ВалютаЦены");
	КонецЕсли;

КонецПроцедуры

// Единицы JSON - базовые единицы измерения (владелец - набор БазовыеЕдиницыИзмерения).
// «шт» берется из классификатора ОКЕИ по коду 796; прочие ищутся по наименованию, затем по
// коду ОКЕИ, если он есть; не нашлось - создается базовая единица с этим наименованием.
//
// Параметры:
//  Контекст - Структура - контекст загрузки, см. НовыйКонтекст; в Единицы кладется
//             соответствие имени единицы JSON и СправочникСсылка.УпаковкиЕдиницыИзмерения.
//
Процедура ПодготовитьЕдиницы(Контекст)

	КодыОКЕИ = Новый Соответствие;
	КодыОКЕИ.Вставить("шт", "796");
	КодыОКЕИ.Вставить("лист", "625");

	Имена = Новый Массив;
	Имена.Добавить("шт");
	Для Каждого Товар Из Контекст.Данные["items"] Цикл
		Если Имена.Найти(Товар["unit"]) = Неопределено Тогда
			Имена.Добавить(Товар["unit"]);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Единицы.Ссылка КАК Ссылка,
	|	Единицы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|ГДЕ
	|	Единицы.Владелец = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
	|	И Единицы.Наименование В (&Имена)
	|	И НЕ Единицы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Единицы.Код";
	Запрос.УстановитьПараметр("Имена", Имена);
	НайденныеПоИмени = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НайденныеПоИмени[НРег(Выборка.Наименование)] = Неопределено Тогда
			НайденныеПоИмени.Вставить(НРег(Выборка.Наименование), Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из Имена Цикл

		Единица = Неопределено;
		КодОКЕИ = КодыОКЕИ[Имя];

		Если Имя <> "шт" Тогда
			Единица = НайденныеПоИмени[НРег(Имя)];
		КонецЕсли;
		Если Единица = Неопределено И КодОКЕИ <> Неопределено Тогда
			ПоКлассификатору = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(КодОКЕИ);
			Единица = ПоКлассификатору[КодОКЕИ];
		КонецЕсли;
		Если Единица = Неопределено Тогда
			Единица = НайденныеПоИмени[НРег(Имя)];
		КонецЕсли;
		Если Единица = Неопределено Тогда
			Единица = НоваяБазоваяЕдиница(Имя);
		КонецЕсли;

		Контекст.Единицы.Вставить(Имя, Единица);

	КонецЦикла;

КонецПроцедуры

Функция НоваяБазоваяЕдиница(Имя)

	Единица = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Единица.Заполнить(Неопределено);
	Единица.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
	Единица.Наименование = Имя;
	Единица.НаименованиеПолное = Имя;
	Единица.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
	Единица.Числитель = 1;
	Единица.Знаменатель = 1;
	Единица.Записать();

	Возврат Единица.Ссылка;

КонецФункции

// Вид номенклатуры «Цветы и флористика»: товар без характеристик, без НДС. Новый вид
// создается типовым Справочники.ВидыНоменклатуры.СоздатьВидНоменклатуры - он заполняет
// реквизиты по умолчанию, группу доступа и реквизиты для контроля.
//
// Параметры:
//  ЕдиницаШтука - СправочникСсылка.УпаковкиЕдиницыИзмерения - единица «шт» для нового вида.
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыНоменклатуры - найденный или созданный вид номенклатуры.
//
Функция ВидНоменклатурыЦветы(ЕдиницаШтука)

	Наименование = НСтр("ru = 'Цветы и флористика'");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	ВидыНоменклатуры.Наименование = &Наименование
	|	И НЕ ВидыНоменклатуры.ЭтоГруппа
	|	И НЕ ВидыНоменклатуры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Наименование", Наименование);
	ДанныеЗаполнения.Вставить("СтавкаНДС", Справочники.СтавкиНДС.БезНДС);
	ДанныеЗаполнения.Вставить("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар);
	ДанныеЗаполнения.Вставить("Описание", НСтр("ru = 'Номенклатура цветочного магазина'"));
	ДанныеЗаполнения.Вставить("ЕдиницаИзмерения", ЕдиницаШтука);
	ДанныеЗаполнения.Вставить("ЕдиницаДляОтчетов", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ДанныеЗаполнения.Вставить("Родитель", Справочники.ВидыНоменклатуры.ПустаяСсылка());
	ДанныеЗаполнения.Вставить("ИспользоватьХарактеристики", Ложь);
	ДанныеЗаполнения.Вставить("ИспользованиеХарактеристик",
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
	ДанныеЗаполнения.Вставить("ВариантОформленияПродажи",
		Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг);

	ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	Справочники.ВидыНоменклатуры.СоздатьВидНоменклатуры(ДанныеЗаполнения, ВидНоменклатуры);

	Возврат ВидНоменклатуры;

КонецФункции

#КонецОбласти

#Область Группы

// Корневая группа «Цветочный магазин» и 9 групп JSON в ней по порядку order. Значок группы
// - присоединенный файл images/groups/<code>.svg с именем <code>; цвет плитки - строкой
// #rrggbb в описании этого файла: у группы номенклатуры реквизит Описание не используется.
//
// Параметры:
//  Контекст - Структура - контекст загрузки, см. НовыйКонтекст; заполняются КорневаяГруппа
//             и Группы.
//  Итог     - Структура - итог загрузки, см. НовыйИтог.
//
Процедура ЗагрузитьГруппы(Контекст, Итог)

	Контекст.КорневаяГруппа = ЗагрузитьГруппу(Контекст, КодКорневойГруппы(), НаименованиеКорневойГруппы(),
		Неопределено, Итог);
	Если Не ЗначениеЗаполнено(Контекст.КорневаяГруппа) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Группа Из ГруппыПоПорядку(Контекст.Данные["groups"]) Цикл
		Ссылка = ЗагрузитьГруппу(Контекст, КодГруппы(Группа["order"]), Группа["name"], Группа, Итог);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Контекст.Группы.Вставить(Группа["code"], Ссылка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Группа со значком в своей транзакции.
//
// Параметры:
//  Контекст     - Структура - контекст загрузки, см. НовыйКонтекст.
//  Код          - Строка - код группы.
//  Наименование - Строка - наименование группы.
//  ДанныеГруппы - Соответствие, Неопределено - группа из JSON; Неопределено - корневая группа
//                 (без значка, родитель пустой).
//  Итог         - Структура - итог загрузки, см. НовыйИтог.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - группа; пустая ссылка, если группа не записана.
//
Функция ЗагрузитьГруппу(Контекст, Код, Наименование, ДанныеГруппы, Итог)

	Если ДанныеГруппы = Неопределено Тогда
		Родитель = Справочники.Номенклатура.ПустаяСсылка();
	Иначе
		Родитель = Контекст.КорневаяГруппа;
	КонецЕсли;
	Счетчики = Новый Структура("Группы, Картинки", НовыеСчетчики(), НовыеСчетчики());

	НачатьТранзакцию();
	Попытка
		Ссылка = ЗаписатьГруппу(Контекст, Код, Наименование, Родитель, Счетчики);
		Если ДанныеГруппы <> Неопределено Тогда
			ЗаписатьЗначокГруппы(Контекст, Ссылка, ДанныеГруппы, Счетчики);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ДобавитьОшибку(Итог, НСтр("ru = 'Группа %1 не записана: %2'"), Код,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;

	ПрибавитьСчетчики(Итог.Подробно, Счетчики);

	Возврат Ссылка;

КонецФункции

Функция ГруппыПоПорядку(Группы)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Группа");
	Для Каждого Группа Из Группы Цикл
		Строка = Таблица.Добавить();
		Строка.Порядок = Группа["order"];
		Строка.Группа = Группа;
	КонецЦикла;
	Таблица.Сортировать("Порядок");

	Возврат Таблица.ВыгрузитьКолонку("Группа");

КонецФункции

Функция ЗаписатьГруппу(Контекст, Код, Наименование, Родитель, Счетчики)

	Ссылка = Контекст.ГруппыПоКоду[Код];

	Если Ссылка = Неопределено Тогда
		Группа = Справочники.Номенклатура.СоздатьГруппу();
		Группа.Код = Код;
		Группа.Наименование = Наименование;
		Группа.Родитель = Родитель;
		Группа.Записать();
		Контекст.ГруппыПоКоду.Вставить(Код, Группа.Ссылка);
		Учесть(Счетчики, "Группы", "Создано");
		Возврат Группа.Ссылка;
	КонецЕсли;

	ЗаблокироватьСсылку(Ссылка);
	Группа = Ссылка.ПолучитьОбъект();
	Если Группа.Наименование = Наименование И Группа.Родитель = Родитель Тогда
		Учесть(Счетчики, "Группы", "Пропущено");
		Возврат Ссылка;
	КонецЕсли;

	Группа.Наименование = Наименование;
	Группа.Родитель = Родитель;
	Группа.Записать();
	Учесть(Счетчики, "Группы", "Обновлено");

	Возврат Ссылка;

КонецФункции

Процедура ЗаписатьЗначокГруппы(Контекст, Группа, ДанныеГруппы, Счетчики)

	Имя = ДанныеГруппы["code"];
	Цвет = ?(ЗначениеЗаполнено(ДанныеГруппы["color"]), ДанныеГруппы["color"], "");

	Найденный = НайденныйФайл(Контекст, Группа, Имя);
	Если Найденный = Неопределено Тогда
		ДобавитьКартинку(Контекст, Группа, Имя, "images/groups/" + Имя + ".svg", Цвет);
		Учесть(Счетчики, "Картинки", "Создано");
		Возврат;
	КонецЕсли;

	Если Найденный.Описание = Цвет Тогда
		Учесть(Счетчики, "Картинки", "Пропущено");
		Возврат;
	КонецЕсли;

	ЗаблокироватьСсылку(Найденный.Ссылка);
	Файл = Найденный.Ссылка.ПолучитьОбъект();
	Файл.Описание = Цвет;
	Файл.Записать();
	Учесть(Счетчики, "Картинки", "Обновлено");

КонецПроцедуры

#КонецОбласти

#Область Товары

// Товар в своей транзакции: элемент номенклатуры, штрихкод, картинка. Цена запоминается и
// записывается после всех товаров одним документом установки цен.
//
// Параметры:
//  Контекст - Структура - контекст загрузки, см. НовыйКонтекст.
//  Товар    - Соответствие - товар из JSON (code, article, name, group, unit, barcode, image, price).
//  Итог     - Структура - итог загрузки, см. НовыйИтог.
//
Процедура ЗагрузитьТовар(Контекст, Товар, Итог)

	Код = Товар["code"];
	Родитель = Контекст.Группы[Товар["group"]];
	Если Родитель = Неопределено Тогда
		ДобавитьОшибку(Итог, НСтр("ru = 'Товар %1 не загружен: нет группы %2'"), Код, Товар["group"]);
		Возврат;
	КонецЕсли;

	Единица = Контекст.Единицы[Товар["unit"]];
	Счетчики = Новый Структура("Товары, Штрихкоды, Картинки",
		НовыеСчетчики(), НовыеСчетчики(), НовыеСчетчики());

	НачатьТранзакцию();
	Попытка
		Ссылка = ЗаписатьТовар(Контекст, Товар, Родитель, Единица, Счетчики);
		ОшибкаШтрихкода = ЗаписатьШтрихкод(Контекст, Ссылка, Товар["barcode"], Счетчики);
		ЗаписатьКартинкуТовара(Контекст, Ссылка, Товар, Счетчики);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ДобавитьОшибку(Итог, НСтр("ru = 'Товар %1 не загружен: %2'"), Код,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Контекст.ТоварыПоКоду.Вставить(Код, Ссылка);
	ПрибавитьСчетчики(Итог.Подробно, Счетчики);
	Если ЗначениеЗаполнено(ОшибкаШтрихкода) Тогда
		Итог.Ошибки.Добавить(ОшибкаШтрихкода);
	КонецЕсли;

	ЗапомнитьЦену(Контекст, Ссылка, Товар, Итог);

КонецПроцедуры

Функция ЗаписатьТовар(Контекст, Товар, Родитель, Единица, Счетчики)

	Ссылка = Контекст.ТоварыПоКоду[Товар["code"]];
	Если Ссылка = Неопределено Тогда
		Ссылка = Контекст.ТоварыПоАртикулу[Товар["article"]];
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.Заполнить(Неопределено);
		Объект.ВидНоменклатуры = Контекст.ВидНоменклатуры;
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);
		ЗаполнитьТовар(Объект, Товар, Родитель, Единица);
		Объект.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
		// Первая запись - без ОбменДанными.Загрузка: ставка НДС уходит в СтавкиНДСНоменклатуры
		// в ПриЗаписи типового модуля объекта.
		Объект.Записать();
		Учесть(Счетчики, "Товары", "Создано");
		Возврат Объект.Ссылка;
	КонецЕсли;

	ЗаблокироватьСсылку(Ссылка);
	Объект = Ссылка.ПолучитьОбъект();
	Если ТоварСовпадает(Объект, Товар, Родитель, Единица, Контекст.ВидНоменклатуры) Тогда
		Учесть(Счетчики, "Товары", "Пропущено");
		Возврат Ссылка;
	КонецЕсли;

	Объект.ВидНоменклатуры = Контекст.ВидНоменклатуры;
	ЗаполнитьТовар(Объект, Товар, Родитель, Единица);
	Объект.Записать();
	Учесть(Счетчики, "Товары", "Обновлено");

	Возврат Ссылка;

КонецФункции

Процедура ЗаполнитьТовар(Объект, Товар, Родитель, Единица)

	Объект.Код = Товар["code"];
	Объект.Артикул = Товар["article"];
	Объект.Наименование = Товар["name"];
	Объект.НаименованиеПолное = Товар["name"];
	Объект.Родитель = Родитель;
	Объект.ЕдиницаИзмерения = Единица;

КонецПроцедуры

Функция ТоварСовпадает(Объект, Товар, Родитель, Единица, ВидНоменклатуры)

	Возврат СокрЛП(Объект.Код) = Товар["code"]
		И Объект.Артикул = Товар["article"]
		И Объект.Наименование = Товар["name"]
		И Объект.НаименованиеПолное = Товар["name"]
		И Объект.Родитель = Родитель
		И Объект.ЕдиницаИзмерения = Единица
		И Объект.ВидНоменклатуры = ВидНоменклатуры;

КонецФункции

// Штрихкод - запись регистра ШтрихкодыНоменклатуры с ключом Штрихкод. Занят чужой
// номенклатурой - не перезаписывается, возвращается текст ошибки.
//
// Параметры:
//  Контекст     - Структура - контекст загрузки, см. НовыйКонтекст.
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//  Штрихкод     - Строка - штрихкод из JSON.
//  Счетчики     - Структура - счетчики товара по видам объектов, см. ПрибавитьСчетчики.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
//
Функция ЗаписатьШтрихкод(Контекст, Номенклатура, Штрихкод, Счетчики)

	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат "";
	КонецЕсли;

	Владелец = Контекст.Штрихкоды[Штрихкод];
	Если Владелец = Номенклатура Тогда
		Учесть(Счетчики, "Штрихкоды", "Пропущено");
		Возврат "";
	КонецЕсли;

	Если Владелец <> Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Штрихкод %1 уже принадлежит номенклатуре «%2», товару %3 не записан'"),
			Штрихкод, Владелец, Номенклатура);
	КонецЕсли;

	Запись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Штрихкод = Штрихкод;
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Запись.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Запись.Записать();
	Контекст.Штрихкоды.Вставить(Штрихкод, Номенклатура);
	Учесть(Счетчики, "Штрихкоды", "Создано");

	Возврат "";

КонецФункции

// Картинка товара - присоединенный файл с именем артикула (FL0001) и основная картинка
// карточки (ФайлКартинки). Файл с этим именем у товара уже есть - не добавляется повторно.
//
// Параметры:
//  Контекст     - Структура - контекст загрузки, см. НовыйКонтекст.
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//  Товар        - Соответствие - товар из JSON.
//  Счетчики     - Структура - счетчики товара по видам объектов, см. ПрибавитьСчетчики.
//
Процедура ЗаписатьКартинкуТовара(Контекст, Номенклатура, Товар, Счетчики)

	ОписаниеКартинки = Товар["image"];
	Если ТипЗнч(ОписаниеКартинки) <> Тип("Соответствие") Или Не ЗначениеЗаполнено(ОписаниеКартинки["file"]) Тогда
		Возврат;
	КонецЕсли;

	Имя = ИмяКартинкиТовара(Товар);
	Найденный = НайденныйФайл(Контекст, Номенклатура, Имя);
	Если Найденный = Неопределено Тогда
		Файл = ДобавитьКартинку(Контекст, Номенклатура, Имя, ОписаниеКартинки["file"], "");
		Исход = "Создано";
	Иначе
		Файл = Найденный.Ссылка;
		Исход = "Пропущено";
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ФайлКартинки") <> Файл Тогда
		ЗаблокироватьСсылку(Номенклатура);
		Объект = Номенклатура.ПолучитьОбъект();
		Объект.ФайлКартинки = Файл;
		// Как в типовом РаботаСНоменклатуройУТ.ПрикрепитьИзображения: меняется одна ссылка на
		// файл, проверки и пересчеты типовой записи не нужны.
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Если Исход = "Пропущено" Тогда
			Исход = "Обновлено";
		КонецЕсли;
	КонецЕсли;

	Учесть(Счетчики, "Картинки", Исход);

КонецПроцедуры

// Добавляет присоединенный файл SVG владельцу номенклатуры.
//
// Параметры:
//  Контекст          - Структура - контекст загрузки, см. НовыйКонтекст.
//  Владелец          - СправочникСсылка.Номенклатура - владелец файла: группа или товар.
//  Имя               - Строка - имя файла без расширения.
//  ОтносительныйПуть - Строка - путь файла от каталога данных через "/".
//  Описание          - Строка - описание файла; у значка группы - цвет плитки.
//
// Возвращаемое значение:
//  СправочникСсылка.НоменклатураПрисоединенныеФайлы - добавленный файл.
//
Функция ДобавитьКартинку(Контекст, Владелец, Имя, ОтносительныйПуть, Описание)

	ПутьКФайлу = ПолныйПуть(Контекст.КаталогДанных, ОтносительныйПуть);
	ФайлНаДиске = Новый Файл(ПутьКФайлу);
	Если Не ФайлНаДиске.Существует() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Нет файла картинки %1'"), ПутьКФайлу);
	КонецЕсли;

	Расширение = НРег(Сред(ФайлНаДиске.Расширение, 2));
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);

	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.АвторизованныйПользователь();
	ПараметрыФайла.ВладелецФайлов = Владелец;
	ПараметрыФайла.ИмяБезРасширения = Имя;
	ПараметрыФайла.РасширениеБезТочки = Расширение;
	ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();

	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
	Файл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адрес, , Описание);
	УдалитьИзВременногоХранилища(Адрес);

	ЗапомнитьФайл(Контекст, Владелец, Имя, Файл, Описание);

	Возврат Файл;

КонецФункции

Процедура ЗаблокироватьСсылку(Ссылка)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось заблокировать «%1»: %2'"), Ссылка,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Цены

// Сравнивает цену JSON с текущей розничной ценой (ПолучитьЦенуПоОтбору) и запоминает
// изменившуюся - для документа установки цен.
//
// Параметры:
//  Контекст     - Структура - контекст загрузки, см. НовыйКонтекст.
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//  Товар        - Соответствие - товар из JSON.
//  Итог         - Структура - итог загрузки, см. НовыйИтог.
//
Процедура ЗапомнитьЦену(Контекст, Номенклатура, Товар, Итог)

	Если Не ЗначениеЗаполнено(Контекст.ВидЦены) Тогда
		ДобавитьОшибку(Итог, НСтр("ru = 'Цена товара %1 не установлена: нет вида цен «%2»'"),
			Товар["code"], Контекст.ВидЦеныИмя);
		Возврат;
	КонецЕсли;

	Цена = Товар["price"];
	Если ТипЗнч(Цена) <> Тип("Число") Или Цена <= 0 Тогда
		ДобавитьОшибку(Итог, НСтр("ru = 'Цена товара %1 не установлена: в JSON цена %2'"),
			Товар["code"], Цена);
		Возврат;
	КонецЕсли;

	Отбор = ЦеныПредприятияЗаполнениеСервер.НовыйПараметрыОтбораПолучитьЦенуПоОтбору();
	Отбор.Дата = Контекст.ДатаЦен;
	Отбор.Валюта = Контекст.ВалютаЦены;
	Отбор.Номенклатура = Номенклатура;
	Отбор.ВидЦены = Контекст.ВидЦены;
	ТекущаяЦена = ЦеныПредприятияЗаполнениеСервер.ПолучитьЦенуПоОтбору(Отбор);

	Если ТекущаяЦена = Цена Тогда
		Учесть(Итог.Подробно, "Цены", "Пропущено");
		Возврат;
	КонецЕсли;

	Строка = Контекст.НовыеЦены.Добавить();
	Строка.Номенклатура = Номенклатура;
	Строка.Код = Товар["code"];
	Строка.Цена = Цена;
	Строка.Исход = ?(ЗначениеЗаполнено(ТекущаяЦена), "Обновлено", "Создано");

КонецПроцедуры

// Изменившиеся цены - одним проведенным документом УстановкаЦенНоменклатуры со статусом
// Согласован: движения в регистр цен документ делает только в этом статусе.
//
// Параметры:
//  Контекст - Структура - контекст загрузки, см. НовыйКонтекст.
//  Итог     - Структура - итог загрузки, см. НовыйИтог.
//
Процедура ЗаписатьЦены(Контекст, Итог)

	НовыеЦены = Контекст.НовыеЦены;
	Если НовыеЦены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИспользуетсяЦенообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25(Контекст.ДатаЦен);

	НачатьТранзакцию();
	Попытка
		УстановкаЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		УстановкаЦен.Заполнить(Неопределено);
		УстановкаЦен.Дата = Контекст.ДатаЦен;
		УстановкаЦен.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
		УстановкаЦен.Комментарий = НСтр("ru = 'Загрузка номенклатуры цветочного магазина'");

		СтрокаВидаЦен = УстановкаЦен.ВидыЦен.Добавить();
		СтрокаВидаЦен.ВидЦены = Контекст.ВидЦены;

		Если ИспользуетсяЦенообразование25 Тогда
			СтрокиЦен = УстановкаЦен.Товары2_5;
		Иначе
			СтрокиЦен = УстановкаЦен.Товары;
		КонецЕсли;
		Для Каждого НоваяЦена Из НовыеЦены Цикл
			Строка = СтрокиЦен.Добавить();
			Строка.Номенклатура = НоваяЦена.Номенклатура;
			Строка.ВидЦены = Контекст.ВидЦены;
			Строка.Цена = НоваяЦена.Цена;
			Строка.Валюта = Контекст.ВалютаЦены;
		КонецЦикла;

		УстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ДобавитьОшибку(Итог, НСтр("ru = 'Цены не установлены (%1 поз.): %2'"), НовыеЦены.Количество(),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого НоваяЦена Из НовыеЦены Цикл
		Учесть(Итог.Подробно, "Цены", НоваяЦена.Исход);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли