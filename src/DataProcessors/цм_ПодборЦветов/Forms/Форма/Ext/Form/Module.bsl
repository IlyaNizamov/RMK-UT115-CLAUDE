#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПостроитьПлитки(Параметры.ВидЦены, Параметры.Валюта);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоискПриИзменении(Элемент)

	Если Не ДобавитьПоШтрихкоду(Поиск) Тогда
		ОбновитьВидимостьПлиток(Поиск);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоискИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	Если ДобавитьПоШтрихкоду(Текст) Тогда
		Элемент.ОбновитьТекстРедактирования();
	Иначе
		ОбновитьВидимостьПлиток(Текст);
	КонецЕсли;

КонецПроцедуры

// Нажатие на любую плитку: группы или цветка. Имя элемента несёт вид плитки и индекс:
// ПлиткаГруппы_<индекс>_<часть>, ПлиткаТовара_<индекс>_<часть>.
// СтандартнаяОбработка передаёт поле картинки; у надписи-декорации параметра нет.
//
// Параметры:
//  Элемент - ПолеФормы, ДекорацияФормы - нажатая часть плитки.
//  СтандартнаяОбработка - Булево - признак стандартной обработки нажатия.
//
&НаКлиенте
Процедура Подключаемый_ПлиткаНажатие(Элемент, СтандартнаяОбработка = Неопределено)

	СтандартнаяОбработка = Ложь;

	ЧастиИмени = СтрРазделить(Элемент.Имя, "_");
	Если ЧастиИмени.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Индекс = Число(ЧастиИмени[1]);
	Если ЧастиИмени[0] = "ПлиткаГруппы" Тогда
		ВыбратьГруппу(Индекс);
	ИначеЕсли ЧастиИмени[0] = "ПлиткаТовара" Тогда
		ДобавитьТоварПлитки(Индекс);
	Иначе
		// Обработчик подключается только к плиткам групп и цветов: иное имя - ошибка построения формы.
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Нажатие на элемент %1 не относится к плиткам подбора'"), Элемент.Имя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыбрано

&НаКлиенте
Процедура ВыбраноКоличествоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Выбрано.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Количество < 1 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	ПересчитатьСтроку(ТекущиеДанные);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПлюсОдин(Команда)

	ИзменитьКоличествоТекущейСтроки(1);

КонецПроцедуры

&НаКлиенте
Процедура МинусОдин(Команда)

	ИзменитьКоличествоТекущейСтроки(-1);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку(Команда)

	ТекущиеДанные = Элементы.Выбрано.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выбрано.Удалить(ТекущиеДанные);
	ПересчитатьИтого();

КонецПроцедуры

// Закрывает форму и возвращает набранное владельцу - форме РМК.
// Результат закрытия - Массив из Структура:
//  * Номенклатура - СправочникСсылка.Номенклатура - цветок.
//  * ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - тип номенклатуры цветка.
//  * КоличествоУпаковок - Число - сколько штук перенести в чек.
//
// Параметры:
//  Команда - КомандаФормы - команда «Перенести в чек».
//
&НаКлиенте
Процедура ПеренестиВЧек(Команда)

	Если Выбрано.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Ничего не выбрано: нажмите на плитку цветка.'"));
		Возврат;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого СтрокаВыбранного Из Выбрано Цикл
		Результат.Добавить(Новый Структура("Номенклатура, ТипНоменклатуры, КоличествоУпаковок",
			СтрокаВыбранного.Номенклатура, СтрокаВыбранного.ТипНоменклатуры, СтрокаВыбранного.Количество));
	КонецЦикла;

	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПостроениеПлиток

&НаСервере
Процедура ПостроитьПлитки(ВидЦены, Валюта)

	Данные = цм_ПлиткиТоваровВызовСервера.ДанныеПлиток(УникальныйИдентификатор, ВидЦены, Валюта);

	Группы.Очистить();
	Товары.Очистить();

	ИндексыГрупп = Новый Соответствие;
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ДобавляемыеРеквизиты = Новый Массив;

	Индекс = 0;
	Для Каждого ДанныеГруппы Из Данные.Группы Цикл
		Индекс = Индекс + 1;
		ИндексыГрупп.Вставить(ДанныеГруппы.Ссылка, Индекс);
		Если Не ПустаяСтрока(ДанныеГруппы.АдресЗначка) Тогда
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяЗначкаГруппы(Индекс), ТипСтрока));
		КонецЕсли;
	КонецЦикла;

	// Реквизит картинки - только у цветка, которому достанется плитка: цветок вне групп
	// ДобавитьПлиткиТоваров пропускает, а индекс плитки считает по всем цветам.
	Индекс = 0;
	Для Каждого ДанныеТовара Из Данные.Товары Цикл
		Индекс = Индекс + 1;
		Если ИндексыГрупп.Получить(ДанныеТовара.Группа) <> Неопределено Тогда
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКартинкиТовара(Индекс), ТипСтрока));
		КонецЕсли;
	КонецЦикла;

	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;

	ТекущаяГруппа = 0;

	ДобавитьПлиткиГрупп(Данные.Группы);
	ДобавитьПлиткиТоваров(Данные.Товары, ИндексыГрупп);

КонецПроцедуры

// Группы - в левой колонке по одной плитке в ряд; первая - «Все товары».
// Цветы каждой группы - в своём контейнере центральной колонки.
//
// Параметры:
//  ДанныеГрупп - Массив из Структура - группы магазина, см. цм_ПлиткиТоваровВызовСервера.ДанныеПлиток.
//
&НаСервере
Процедура ДобавитьПлиткиГрупп(ДанныеГрупп)

	ДанныеВсех = Новый Структура("Наименование, Цвет, АдресЗначка", НаименованиеВсехТоваров(), "#5F6B73", "");
	ДобавитьПлиткуГруппы(0, ДанныеВсех);

	Индекс = 0;
	Для Каждого ДанныеГруппы Из ДанныеГрупп Цикл

		Индекс = Индекс + 1;

		СтрокаГруппы = Группы.Добавить();
		СтрокаГруппы.Индекс = Индекс;
		СтрокаГруппы.Ссылка = ДанныеГруппы.Ссылка;
		СтрокаГруппы.Наименование = ДанныеГруппы.Наименование;

		ДобавитьПлиткуГруппы(Индекс, ДанныеГруппы);

		Если Не ПустаяСтрока(ДанныеГруппы.АдресЗначка) Тогда
			ЭтотОбъект[ИмяЗначкаГруппы(Индекс)] = ДанныеГруппы.АдресЗначка;
		КонецЕсли;

		Контейнер = Элементы.Добавить("ТоварыГруппы_" + ЧислоДляИмени(Индекс), Тип("ГруппаФормы"), Элементы.СтраницаТоваров);
		НастроитьГруппуБезОформления(Контейнер, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПлиткуГруппы(Индекс, ДанныеГруппы)

	ИмяПлитки = "ПлиткаГруппы_" + ЧислоДляИмени(Индекс);

	Плитка = Элементы.Добавить(ИмяПлитки, Тип("ГруппаФормы"), Элементы.СтраницаГрупп);
	НастроитьГруппуБезОформления(Плитка, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	Плитка.Ширина = ШиринаПлиткиГруппы();
	Плитка.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	Цвет = ЦветИзСтроки(ДанныеГруппы.Цвет);
	Если Цвет <> Неопределено Тогда
		Плитка.ЦветФона = Цвет;
	КонецЕсли;

	Если Не ПустаяСтрока(ДанныеГруппы.АдресЗначка) Тогда
		Значок = Элементы.Добавить(ИмяПлитки + "_Значок", Тип("ПолеФормы"), Плитка);
		Значок.Вид = ВидПоляФормы.ПолеКартинки;
		Значок.ПутьКДанным = ИмяЗначкаГруппы(Индекс);
		НастроитьПолеКартинки(Значок, 8, 2);
	КонецЕсли;

	Надпись = Элементы.Добавить(ИмяПлитки + "_Надпись", Тип("ДекорацияФормы"), Плитка);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = ЗаголовокПлиткиГруппы(ДанныеГруппы.Наименование, Индекс = ТекущаяГруппа);
	Надпись.Ширина = ШиринаПлиткиГруппы();
	Надпись.Высота = 2;
	Надпись.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	// Синяя ссылка на цветном фоне плитки не читается.
	Надпись.ЦветТекста = WebЦвета.Белый;
	Надпись.Гиперссылка = Истина;
	Надпись.УстановитьДействие("Нажатие", "Подключаемый_ПлиткаНажатие");

КонецПроцедуры

&НаСервере
Процедура ДобавитьПлиткиТоваров(ДанныеТоваров, ИндексыГрупп)

	ПозицииВГруппах = Новый Соответствие;

	Индекс = 0;
	Для Каждого ДанныеТовара Из ДанныеТоваров Цикл

		Индекс = Индекс + 1;
		ИндексГруппы = ИндексыГрупп.Получить(ДанныеТовара.Группа);
		Если ИндексГруппы = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТовара = Товары.Добавить();
		СтрокаТовара.Индекс = Индекс;
		СтрокаТовара.Ссылка = ДанныеТовара.Ссылка;
		СтрокаТовара.Наименование = ДанныеТовара.Наименование;
		СтрокаТовара.НаименованиеНРег = НРег(ДанныеТовара.Наименование);
		СтрокаТовара.ИндексГруппы = ИндексГруппы;
		СтрокаТовара.Цена = ДанныеТовара.Цена;
		СтрокаТовара.Штрихкоды = ДанныеТовара.Штрихкоды;
		СтрокаТовара.ТипНоменклатуры = ДанныеТовара.ТипНоменклатуры;

		Позиция = ?(ПозицииВГруппах.Получить(ИндексГруппы) = Неопределено, 0, ПозицииВГруппах.Получить(ИндексГруппы));
		ПозицииВГруппах.Вставить(ИндексГруппы, Позиция + 1);

		Контейнер = Элементы["ТоварыГруппы_" + ЧислоДляИмени(ИндексГруппы)];
		НомерРяда = Цел(Позиция / ПлитокТоваровВРяду()) + 1;
		Ряд = РядПлиток(Контейнер, "РядТоваров_" + ЧислоДляИмени(ИндексГруппы) + "_" + ЧислоДляИмени(НомерРяда));

		ДобавитьПлиткуТовара(Индекс, ДанныеТовара, Ряд);
		ЭтотОбъект[ИмяКартинкиТовара(Индекс)] = ДанныеТовара.АдресКартинки;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПлиткуТовара(Индекс, ДанныеТовара, Ряд)

	ИмяПлитки = "ПлиткаТовара_" + ЧислоДляИмени(Индекс);

	Плитка = Элементы.Добавить(ИмяПлитки, Тип("ГруппаФормы"), Ряд);
	НастроитьГруппуБезОформления(Плитка, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	Плитка.Ширина = 13;
	Плитка.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;

	// 12×5 - около 120×101 пикселей на экране (замер в РМК, подплан 05), не меньше 96×96 по ТЗ.
	Картинка = Элементы.Добавить(ИмяПлитки + "_Картинка", Тип("ПолеФормы"), Плитка);
	Картинка.Вид = ВидПоляФормы.ПолеКартинки;
	Картинка.ПутьКДанным = ИмяКартинкиТовара(Индекс);
	Картинка.ТекстНевыбраннойКартинки = ДанныеТовара.Наименование;
	НастроитьПолеКартинки(Картинка, 12, 5);

	Надпись = Элементы.Добавить(ИмяПлитки + "_Надпись", Тип("ДекорацияФормы"), Плитка);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = СтрШаблон("%1
		|%2", ДанныеТовара.Наименование, Формат(ДанныеТовара.Цена, "ЧДЦ=2; ЧН=0"));
	Надпись.Ширина = 13;
	// Наименование в три строки и цена.
	Надпись.Высота = 4;
	Надпись.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	Надпись.Гиперссылка = Истина;
	Надпись.УстановитьДействие("Нажатие", "Подключаемый_ПлиткаНажатие");

КонецПроцедуры

&НаСервере
Процедура НастроитьПолеКартинки(Поле, Ширина, Высота)

	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.АвтоМаксимальнаяШирина = Ложь;
	Поле.АвтоМаксимальнаяВысота = Ложь;
	Поле.РастягиватьПоГоризонтали = Ложь;
	Поле.РастягиватьПоВертикали = Ложь;
	Поле.Ширина = Ширина;
	Поле.МаксимальнаяШирина = Ширина;
	Поле.Высота = Высота;
	Поле.МаксимальнаяВысота = Высота;
	Поле.РазмерКартинки = РазмерКартинки.Пропорционально;
	Поле.Гиперссылка = Истина;
	Поле.УстановитьДействие("Нажатие", "Подключаемый_ПлиткаНажатие");

КонецПроцедуры

&НаСервере
Функция РядПлиток(Родитель, ИмяРяда)

	Ряд = Элементы.Найти(ИмяРяда);
	Если Ряд = Неопределено Тогда
		Ряд = Элементы.Добавить(ИмяРяда, Тип("ГруппаФормы"), Родитель);
		НастроитьГруппуБезОформления(Ряд, ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);
	КонецЕсли;

	Возврат Ряд;

КонецФункции

&НаСервере
Процедура НастроитьГруппуБезОформления(Группа, Группировка)

	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = Группировка;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;

КонецПроцедуры

&НаСервере
Функция ЦветИзСтроки(СтрокаЦвета)

	Если СтрДлина(СтрокаЦвета) <> 7 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Красный = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(СтрокаЦвета, 2, 2));
	Зеленый = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(СтрокаЦвета, 4, 2));
	Синий = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(СтрокаЦвета, 6, 2));

	// @skip-check new-color - цвет плитки задаёт группа номенклатуры, а не стиль
	Возврат Новый Цвет(Красный, Зеленый, Синий);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяЗначкаГруппы(Индекс)

	Возврат "ЗначокГруппы_" + ЧислоДляИмени(Индекс);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяКартинкиТовара(Индекс)

	Возврат "КартинкаТовара_" + ЧислоДляИмени(Индекс);

КонецФункции

// Число для имени элемента: без разделителей разрядов, ноль - «0».
// XMLСтрока здесь не годится: в веб-клиенте её нет, и клиентская часть модуля не компилируется.
//
// Параметры:
//  Число - Число - индекс плитки, ряда или группы.
//
// Возвращаемое значение:
//  Строка - число цифрами.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЧислоДляИмени(Число)

	Возврат Формат(Число, "ЧН=0; ЧГ=0");

КонецФункции

// Подпись плитки группы; выбранная группа отмечена треугольником перед наименованием.
//
// Параметры:
//  Наименование - Строка - наименование группы.
//  Выбрана - Булево - группа выбрана.
//
// Возвращаемое значение:
//  Строка - подпись плитки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокПлиткиГруппы(Наименование, Выбрана)

	Возврат ?(Выбрана, "▶ ", "") + Наименование;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НаименованиеВсехТоваров()

	Возврат НСтр("ru = 'Все товары'");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ШиринаПлиткиГруппы()

	Возврат 12;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПлитокТоваровВРяду()

	// Ширину окна подбора задаёт содержимое: при четырёх плитках в ряд «Выбрано» теряет колонки.
	Возврат 3;

КонецФункции

#КонецОбласти

#Область ВыборИОтбор

// Выбор группы в левой колонке: в центре - цветы группы (0 - все группы), поиск сбрасывается.
//
// Параметры:
//  Индекс - Число - индекс группы.
//
&НаКлиенте
Процедура ВыбратьГруппу(Индекс)

	ОтметитьГруппу(ТекущаяГруппа, Ложь);
	ТекущаяГруппа = Индекс;
	ОтметитьГруппу(ТекущаяГруппа, Истина);

	Поиск = "";
	ОбновитьВидимостьПлиток("");

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьГруппу(Индекс, Выбрана)

	Если Индекс = 0 Тогда
		Наименование = НаименованиеВсехТоваров();
	Иначе
		Найденные = Группы.НайтиСтроки(Новый Структура("Индекс", Индекс));
		Если Найденные.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Наименование = Найденные[0].Наименование;
	КонецЕсли;

	ИмяНадписи = "ПлиткаГруппы_" + ЧислоДляИмени(Индекс) + "_Надпись";
	Элементы[ИмяНадписи].Заголовок = ЗаголовокПлиткиГруппы(Наименование, Выбрана);

КонецПроцедуры

// Видимость плиток цветов: без поиска - цветы выбранной группы (0 - все группы),
// с поиском - цветы всех групп, в наименовании которых есть подстрока.
//
// Параметры:
//  Текст - Строка - строка поиска.
//
&НаКлиенте
Процедура ОбновитьВидимостьПлиток(Текст)

	Подстрока = НРег(СокрЛП(Текст));
	ЕстьПоиск = Не ПустаяСтрока(Подстрока);

	ГруппыСНайденным = Новый Соответствие;
	Для Каждого СтрокаТовара Из Товары Цикл
		Видимость = Не ЕстьПоиск Или СтрНайти(СтрокаТовара.НаименованиеНРег, Подстрока) > 0;
		Плитка = Элементы["ПлиткаТовара_" + ЧислоДляИмени(СтрокаТовара.Индекс)];
		Если Плитка.Видимость <> Видимость Тогда
			Плитка.Видимость = Видимость;
		КонецЕсли;
		Если Видимость Тогда
			ГруппыСНайденным.Вставить(СтрокаТовара.ИндексГруппы, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаГруппы Из Группы Цикл
		Если ЕстьПоиск Тогда
			Видимость = ГруппыСНайденным.Получить(СтрокаГруппы.Индекс) <> Неопределено;
		Иначе
			Видимость = ТекущаяГруппа = 0 Или ТекущаяГруппа = СтрокаГруппы.Индекс;
		КонецЕсли;
		Контейнер = Элементы["ТоварыГруппы_" + ЧислоДляИмени(СтрокаГруппы.Индекс)];
		Если Контейнер.Видимость <> Видимость Тогда
			Контейнер.Видимость = Видимость;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Выбранное

// Добавляет 1 шт. цветка по штрихкоду из поля поиска: ровно 13 цифр, совпавших со штрихкодом плитки.
// Найденный цветок попадает в «Выбрано», поле поиска очищается.
//
// Параметры:
//  Текст - Строка - текст поля поиска.
//
// Возвращаемое значение:
//  Булево - Истина, если цветок найден и добавлен.
//
&НаКлиенте
Функция ДобавитьПоШтрихкоду(Текст)

	Штрихкод = СокрЛП(Текст);
	Если СтрДлина(Штрихкод) <> 13 Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого СтрокаТовара Из Товары Цикл
		Если СтрРазделить(СтрокаТовара.Штрихкоды, ";", Ложь).Найти(Штрихкод) <> Неопределено Тогда
			Поиск = "";
			ОбновитьВидимостьПлиток("");
			ДобавитьВВыбранное(СтрокаТовара, 1);
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ДобавитьТоварПлитки(Индекс)

	Найденные = Товары.НайтиСтроки(Новый Структура("Индекс", Индекс));
	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВВыбранное(Найденные[0], 1);

КонецПроцедуры

// Прибавляет количество к строке «Выбрано» с тем же цветком или добавляет строку.
//
// Параметры:
//  СтрокаТовара - ДанныеФормыЭлементКоллекции - строка таблицы Товары.
//  Количество - Число - сколько штук добавить.
//
&НаКлиенте
Процедура ДобавитьВВыбранное(СтрокаТовара, Количество)

	Найденные = Выбрано.НайтиСтроки(Новый Структура("Номенклатура", СтрокаТовара.Ссылка));
	Если Найденные.Количество() = 0 Тогда
		СтрокаВыбранного = Выбрано.Добавить();
		СтрокаВыбранного.Номенклатура = СтрокаТовара.Ссылка;
		СтрокаВыбранного.ТипНоменклатуры = СтрокаТовара.ТипНоменклатуры;
		СтрокаВыбранного.Наименование = СтрокаТовара.Наименование;
		СтрокаВыбранного.Цена = СтрокаТовара.Цена;
	Иначе
		СтрокаВыбранного = Найденные[0];
	КонецЕсли;

	СтрокаВыбранного.Количество = СтрокаВыбранного.Количество + Количество;
	ПересчитатьСтроку(СтрокаВыбранного);

	Элементы.Выбрано.ТекущаяСтрока = СтрокаВыбранного.ПолучитьИдентификатор();

КонецПроцедуры

// Меняет количество текущей строки «Выбрано»; меньше 1 не опускается - для этого «Удалить».
//
// Параметры:
//  Изменение - Число - на сколько изменить количество.
//
&НаКлиенте
Процедура ИзменитьКоличествоТекущейСтроки(Изменение)

	ТекущиеДанные = Элементы.Выбрано.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НовоеКоличество = ТекущиеДанные.Количество + Изменение;
	Если НовоеКоличество < 1 Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные.Количество = НовоеКоличество;
	ПересчитатьСтроку(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтроку(СтрокаВыбранного)

	СтрокаВыбранного.Сумма = СтрокаВыбранного.Количество * СтрокаВыбранного.Цена;
	ПересчитатьИтого();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтого()

	Итого = Выбрано.Итог("Сумма");

КонецПроцедуры

#КонецОбласти

#КонецОбласти