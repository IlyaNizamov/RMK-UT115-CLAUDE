#Область ПрограммныйИнтерфейс

// Возвращает данные для панели плиток рабочего места кассира: группы магазина и их товары
// с ценой, картинкой и штрихкодами.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы, во временное хранилище
//                            которой помещаются картинки товаров и значки групп.
//  ВидЦены - СправочникСсылка.ВидыЦен, Неопределено - вид цен чека; не передан или пуст - «Розничная».
//  Валюта - СправочникСсылка.Валюты, Неопределено - валюта цены; не передана или пуста - базовая.
//
// Возвращаемое значение:
//  Структура:
//   * Группы - Массив из Структура:
//      ** Ссылка - СправочникСсылка.Номенклатура - группа номенклатуры.
//      ** Наименование - Строка - наименование группы.
//      ** Цвет - Строка - цвет плитки строкой "#rrggbb" из описания группы; пустая строка, если не задан.
//      ** АдресЗначка - Строка - адрес значка группы во временном хранилище; пустая строка, если значка нет.
//   * Товары - Массив из Структура:
//      ** Ссылка - СправочникСсылка.Номенклатура - товар.
//      ** Наименование - Строка - наименование товара.
//      ** Цена - Число - цена по виду цен.
//      ** Группа - СправочникСсылка.Номенклатура - группа товара.
//      ** АдресКартинки - Строка - адрес картинки товара во временном хранилище; пустая строка, если картинки нет.
//      ** Штрихкоды - Строка - штрихкоды товара через ";".
//      ** ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - тип номенклатуры товара.
//
Функция ДанныеПлиток(УникальныйИдентификатор, ВидЦены = Неопределено, Валюта = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Группы", Новый Массив);
	Результат.Вставить("Товары", Новый Массив);

	КорневаяГруппа = КорневаяГруппаМагазина();
	Если Не ЗначениеЗаполнено(КорневаяГруппа) Тогда
		Возврат Результат;
	КонецЕсли;

	ВидЦеныПлиток = ?(ЗначениеЗаполнено(ВидЦены), ВидЦены, ВидЦеныПоУмолчанию());
	ВалютаПлиток = ?(ЗначениеЗаполнено(Валюта), Валюта, ЗначениеНастроекПовтИсп.БазоваяВалютаПоУмолчанию());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КорневаяГруппа", КорневаяГруппа);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Группы.Ссылка КАК Ссылка,
	|	Группы.Наименование КАК Наименование,
	|	Группы.Код КАК Код
	|ПОМЕСТИТЬ ВТГруппы
	|ИЗ
	|	Справочник.Номенклатура КАК Группы
	|ГДЕ
	|	Группы.ЭтоГруппа
	|	И Группы.Родитель = &КорневаяГруппа
	|	И НЕ Группы.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТГруппы.Ссылка КАК Ссылка,
	|	ВТГруппы.Наименование КАК Наименование
	|ИЗ
	|	ВТГруппы КАК ВТГруппы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТГруппы.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Файлы.ВладелецФайла КАК Группа,
	|	Файлы.Ссылка КАК Файл,
	|	ВЫРАЗИТЬ(Файлы.Описание КАК СТРОКА(20)) КАК Цвет
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла В
	|			(ВЫБРАТЬ
	|				ВТГруппы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТГруппы КАК ВТГруппы)
	|	И НЕ Файлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Файлы.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Родитель КАК Группа,
	|	Товары.ФайлКартинки КАК ФайлКартинки,
	|	Товары.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	НЕ Товары.ЭтоГруппа
	|	И НЕ Товары.ПометкаУдаления
	|	И Товары.Родитель В
	|			(ВЫБРАТЬ
	|				ВТГруппы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТГруппы КАК ВТГруппы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Номенклатура.Родитель В
	|			(ВЫБРАТЬ
	|				ВТГруппы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТГруппы КАК ВТГруппы)";

	Пакет = Запрос.ВыполнитьПакет();
	ВыборкаГрупп = Пакет[1].Выбрать();
	ЗначкиГрупп = ПервыйФайлПоВладельцу(Пакет[2].Выгрузить());
	ВыборкаТоваров = Пакет[3].Выбрать();
	ШтрихкодыТоваров = ШтрихкодыПоНоменклатуре(Пакет[4].Выгрузить());

	Пока ВыборкаГрупп.Следующий() Цикл

		ЗначокГруппы = ЗначкиГрупп.Получить(ВыборкаГрупп.Ссылка);

		ДанныеГруппы = Новый Структура;
		ДанныеГруппы.Вставить("Ссылка", ВыборкаГрупп.Ссылка);
		ДанныеГруппы.Вставить("Наименование", ВыборкаГрупп.Наименование);
		ДанныеГруппы.Вставить("Цвет", ?(ЗначокГруппы = Неопределено, "", ЦветИзОписания(ЗначокГруппы.Цвет)));
		ДанныеГруппы.Вставить("АдресЗначка", ?(ЗначокГруппы = Неопределено, "", АдресФайла(ЗначокГруппы.Файл, УникальныйИдентификатор)));
		Результат.Группы.Добавить(ДанныеГруппы);

	КонецЦикла;

	ДатаЦены = ТекущаяДатаСеанса();

	Пока ВыборкаТоваров.Следующий() Цикл

		ШтрихкодыТовара = ШтрихкодыТоваров.Получить(ВыборкаТоваров.Ссылка);

		ДанныеТовара = Новый Структура;
		ДанныеТовара.Вставить("Ссылка", ВыборкаТоваров.Ссылка);
		ДанныеТовара.Вставить("Наименование", ВыборкаТоваров.Наименование);
		ДанныеТовара.Вставить("Цена", ЦенаТовара(ВыборкаТоваров.Ссылка, ВидЦеныПлиток, ВалютаПлиток, ДатаЦены));
		ДанныеТовара.Вставить("Группа", ВыборкаТоваров.Группа);
		ДанныеТовара.Вставить("АдресКартинки", АдресФайла(ВыборкаТоваров.ФайлКартинки, УникальныйИдентификатор));
		ДанныеТовара.Вставить("Штрихкоды", ?(ШтрихкодыТовара = Неопределено, "", СтрСоединить(ШтрихкодыТовара, ";")));
		ДанныеТовара.Вставить("ТипНоменклатуры", ВыборкаТоваров.ТипНоменклатуры);
		Результат.Товары.Добавить(ДанныеТовара);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Корневая группа номенклатуры магазина - группа с кодом "ЦВГ-00".
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, Неопределено - корневая группа; Неопределено, если её нет.
//
Функция КорневаяГруппаМагазина()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", "ЦВГ-00");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Группы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Группы
	|ГДЕ
	|	Группы.ЭтоГруппа
	|	И Группы.Код = &Код
	|	И НЕ Группы.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Вид цен «Розничная».
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыЦен - найденный вид цен или пустая ссылка.
//
Функция ВидЦеныПоУмолчанию()

	Возврат Справочники.ВидыЦен.НайтиПоНаименованию("Розничная", Истина);

КонецФункции

// Цена товара по виду цен типовой функцией получения цены.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар.
//  ВидЦены - СправочникСсылка.ВидыЦен - вид цен.
//  Валюта - СправочникСсылка.Валюты - валюта цены.
//  Дата - Дата - дата цены.
//
// Возвращаемое значение:
//  Число - цена; 0, если цена не установлена.
//
Функция ЦенаТовара(Номенклатура, ВидЦены, Валюта, Дата)

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Валюта", Валюта);
	ПараметрыОтбора.Вставить("Дата", Дата);
	ПараметрыОтбора.Вставить("ВидЦены", ВидЦены);
	ПараметрыОтбора.Вставить("Номенклатура", Номенклатура);
	ПараметрыОтбора.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПараметрыОтбора.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
	ПараметрыОтбора.Вставить("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());

	Возврат ЦеныПредприятияЗаполнениеСервер.ПолучитьЦенуПоОтбору(ПараметрыОтбора);

КонецФункции

// Адрес двоичных данных присоединённого файла во временном хранилище формы.
//
// Параметры:
//  Файл - СправочникСсылка.НоменклатураПрисоединенныеФайлы, Неопределено - файл.
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы.
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище; пустая строка, если файла нет или он не читается.
//
Функция АдресФайла(Файл, УникальныйИдентификатор)

	Если Не ЗначениеЗаполнено(Файл) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Адрес = РаботаСФайлами.ДанныеФайла(Файл, УникальныйИдентификатор).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Плитки товаров. Картинка'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение, , Файл,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Адрес = "";
	КонецПопытки;

	Возврат Адрес;

КонецФункции

// Первый по наименованию файл каждого владельца - значок группы; цвет плитки группы загрузка
// кладёт в описание этого файла (у групп номенклатуры своего реквизита «Описание» нет).
//
// Параметры:
//  ТаблицаФайлов - ТаблицаЗначений - колонки Группа, Файл и Цвет, упорядочена по наименованию файла.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Номенклатура - владелец файла.
//   * Значение - Структура - значок группы:
//     ** Файл - СправочникСсылка.НоменклатураПрисоединенныеФайлы - файл.
//     ** Цвет - Строка - описание файла.
//
Функция ПервыйФайлПоВладельцу(ТаблицаФайлов)

	Результат = Новый Соответствие;
	Для Каждого СтрокаФайла Из ТаблицаФайлов Цикл
		Если Результат.Получить(СтрокаФайла.Группа) = Неопределено Тогда
			Результат.Вставить(СтрокаФайла.Группа, Новый Структура("Файл, Цвет", СтрокаФайла.Файл, СтрокаФайла.Цвет));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Штрихкоды, собранные по номенклатуре.
//
// Параметры:
//  ТаблицаШтрихкодов - ТаблицаЗначений - колонки Номенклатура и Штрихкод.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Номенклатура - товар.
//   * Значение - Массив из Строка - штрихкоды товара.
//
Функция ШтрихкодыПоНоменклатуре(ТаблицаШтрихкодов)

	Результат = Новый Соответствие;
	Для Каждого СтрокаШтрихкода Из ТаблицаШтрихкодов Цикл
		Штрихкоды = Результат.Получить(СтрокаШтрихкода.Номенклатура);
		Если Штрихкоды = Неопределено Тогда
			Штрихкоды = Новый Массив;
			Результат.Вставить(СтрокаШтрихкода.Номенклатура, Штрихкоды);
		КонецЕсли;
		Штрихкоды.Добавить(СокрЛП(СтрокаШтрихкода.Штрихкод));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Цвет плитки из описания значка группы: строка вида "#rrggbb" в начале описания.
//
// Параметры:
//  Описание - Строка - начало описания файла значка.
//
// Возвращаемое значение:
//  Строка - цвет "#rrggbb" в нижнем регистре; пустая строка, если описание не начинается с цвета.
//
Функция ЦветИзОписания(Описание)

	Цвет = НРег(Лев(СокрЛП(Описание), 7));
	Если СтрДлина(Цвет) <> 7 Или Лев(Цвет, 1) <> "#" Тогда
		Возврат "";
	КонецЕсли;

	Для Позиция = 2 По 7 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Цвет, Позиция, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Цвет;

КонецФункции

#КонецОбласти